[Unit]
Description=DoorFlow application
After=network.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=doorflow
Group=doorflow
WorkingDirectory=/srv/doorflow/current
EnvironmentFile=/etc/doorflow/doorflow.env
Environment=NODE_ENV=production
Environment=HOSTNAME=127.0.0.1
Environment=PORT=3000
UMask=0077
ExecStartPre=/usr/bin/node /srv/doorflow/current/scripts/check-production-env.mjs
ExecStart=/usr/bin/npm run start -- --hostname 127.0.0.1
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=full
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
SyslogIdentifier=doorflow

[Install]
WantedBy=multi-user.target
