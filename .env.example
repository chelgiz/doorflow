# Local-only PostgreSQL connection. Copy to .env for Docker Compose development.
DATABASE_URL="postgresql://doorflow:doorflow_local_only@127.0.0.1:54329/doorflow?schema=public"

# Keep demo mode enabled unless this deployment has a real, configured store.
DOORFLOW_DEMO_MODE="true"
# Set to a Store UUID created in the database only after configuring a real store.
DOORFLOW_STORE_ID=""
# Version of the personal-data notice shown on the request forms.
DOORFLOW_CONSENT_NOTICE_VERSION="v1"
# Use a real HTTPS privacy notice URL before enabling customer submissions.
DOORFLOW_PRIVACY_NOTICE_URL=""

# Required before enabling public submissions. Use a random secret of at least 32 characters.
DOORFLOW_RATE_LIMIT_SECRET=""
# Defaults to 5 submissions per 15 minutes per client IP.
DOORFLOW_PUBLIC_LEAD_RATE_LIMIT="5"
DOORFLOW_PUBLIC_LEAD_WINDOW_SECONDS="900"

# Production backup settings. NODE_ENV=production requires encryption and offsite transfer.
DOORFLOW_BACKUP_DIR="/var/backups/doorflow"
DOORFLOW_BACKUP_AGE_RECIPIENT=""
DOORFLOW_BACKUP_REMOTE=""
